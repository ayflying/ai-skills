# Teambition OpenAPI 网关
TEAMBITION_GATEWAY=https://open.teambition.com/api

# 个人账号凭证：从已登录 Teambition 的浏览器请求中获取 userToken
# 真实值只写入本地 .env 或当前 Shell 环境变量，不要提交
TEAMBITION_USER_TOKEN=your_user_token

# 企业 ID：企业链接 /organization/<id>/my 中的 24 位 ID
TEAMBITION_TENANT_ID=your_organization_id

# 操作者用户 ID：可选。个人 token 通常按当前账号权限执行；如企业接口要求操作者再填写。
TEAMBITION_OPERATOR_ID=your_user_id
